html, body { margin: 0; padding: 0; font-family: Arial, sans-serif; background: #f5f7f5; color: #152c2a; }
* { box-sizing: border-box; }
a { color: inherit; text-decoration: none; }
.auth-shell { min-height: 100vh; display: grid; place-items: center; background: linear-gradient(135deg, #dfece4, #f8f5ef); }
.auth-card { width: min(92vw, 460px); background: white; border-radius: 20px; box-shadow: 0 20px 50px rgba(17, 41, 35, .08); padding: 32px; }
.auth-card h1 { margin: 0 0 8px; color: #0b5539; }
.auth-card p { margin-top: 0; color: #4d5e59; }
.auth-form { display: grid; gap: 16px; margin-top: 20px; }
.auth-form label { display: grid; gap: 8px; color: #21463d; font-weight: 700; }
.auth-form input { border: 1px solid #dbe1df; border-radius: 10px; padding: 12px 13px; font-size: 16px; }
.auth-form button, .logout-link { background: #0b5539; color: white; border: 0; border-radius: 10px; padding: 12px 18px; font-weight: 700; cursor: pointer; }
.error-box { background: #fbe8e6; color: #7a2c2c; border: 1px solid #ebc1bb; border-radius: 10px; padding: 10px 12px; }
.demo-credentials { margin-top: 22px; color: #445d56; font-size: 0.92rem; }
.dashboard-shell { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; }
.dashboard-sidebar { background: #0a2d26; color: white; padding: 28px 20px; }
.dashboard-sidebar h2 { margin: 0 0 30px; color: #ebefea; }
.dashboard-sidebar nav { display: grid; gap: 12px; }
.dashboard-sidebar nav a { padding: 10px 12px; border-radius: 10px; background: rgba(255,255,255,0.04); font-weight: 600; }
.dashboard-main { padding: 28px; }
.topbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 28px; }
.topbar h1 { margin: 0; font-size: clamp(1.8rem, 2vw, 2.8rem); color: #0b5539; }
.topbar p { margin: 6px 0 0; color: #506560; }
.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 18px; }
.stat-card { background: white; border-radius: 18px; border: 1px solid #e6ece8; box-shadow: 0 16px 26px rgba(12, 41, 33, .05); padding: 20px; }
.stat-card label { display: block; color: #61726e; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.1em; }
.stat-card strong { display: block; margin-top: 12px; font-size: 2rem; color: #15392f; }
.logout-link { display: inline-block; background: #f4f8f7; color: #0b5539; border: 1px solid #dcebe7; }
